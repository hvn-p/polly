{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-events",
  "$defs": {
    "eventCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "agentEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "test"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHORIZED",
            "INVALID_EVENT_CODE",
            "EVENT_CODE_REVOKED",
            "EVENT_CODE_NOT_BOUND",
            "EVENT_CODE_ALREADY_BOUND"
          ]
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  }
}
