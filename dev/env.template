# The keys of a worktree's .env.local, and how dev:up generates each one the
# first time. A value already in .env.local is never rewritten.
#
#   {{identity}}          derived from the branch at the first run
#   {{database}} {{test-database}} {{role}} {{bucket}} {{host}}
#                         derived from POLLY_WORKTREE_ID
#   {{free-port}}         a port free at the first run
#   {{base64url:N}}       N random bytes, base64url
#   {{hex:N}}             N random bytes, hexadecimal
#   ${KEY}                the value of a key above

POLLY_WORKTREE_ID={{identity}}
POLLY_ENV=local
PUBLIC_URL=https://{{host}}
POLLY_MCP_URL=${PUBLIC_URL}/mcp
POLLY_EVENTS_URL=${PUBLIC_URL}/api/agent-events
POLLY_API_PORT={{free-port}}
POLLY_WEB_PORT={{free-port}}

# The shared Postgres of dev/compose.yaml; the worktree's own role.
DATABASE_URL=postgresql://{{role}}:{{hex:24}}@127.0.0.1:55432/{{database}}
TEST_DATABASE_URL=${DATABASE_URL}_test

# The shared Garage of dev/compose.yaml; the key is imported by dev:up.
S3_ENDPOINT=http://127.0.0.1:53900
S3_REGION=garage
S3_BUCKET={{bucket}}
S3_ACCESS_KEY_ID=GK{{hex:12}}
S3_SECRET_ACCESS_KEY={{hex:32}}

BETTER_AUTH_SECRET={{base64url:32}}
POLLY_WORKER_MODE=fake
