{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "placeholder-analysis",
  "$defs": {
    "PlaceholderAnalysisTask": {
      "type": "object",
      "properties": {
        "queueName": {
          "type": "string",
          "const": "pron-analysis"
        },
        "workflowName": {
          "type": "string",
          "const": "placeholder_analysis"
        },
        "applicationVersion": {
          "type": "string",
          "const": "polly-skeleton-1"
        }
      },
      "required": [
        "queueName",
        "workflowName",
        "applicationVersion"
      ],
      "additionalProperties": false
    },
    "PlaceholderAnalysisInput": {
      "type": "object",
      "properties": {
        "recordingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "recordingId"
      ],
      "additionalProperties": false
    },
    "PlaceholderAnalysisResult": {
      "type": "object",
      "properties": {
        "recordingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "analyzer": {
          "type": "string",
          "enum": [
            "fake",
            "model"
          ]
        },
        "modelLoaded": {
          "type": "boolean"
        }
      },
      "required": [
        "recordingId",
        "score",
        "analyzer",
        "modelLoaded"
      ],
      "additionalProperties": false
    }
  }
}
